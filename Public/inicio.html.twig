<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    <link rel="stylesheet" href="../Public/css/style.css">
    <link rel="stylesheet" href="../Public/css/responsive.css">
    <script src="https://kit.fontawesome.com/58f9dcf30d.js" crossorigin="anonymous"></script>
    <link rel="icon" href="">
    <title>Gym</title>
</head>

<body>
<div class="indexContainer">

    {% include 'header.html.twig' %}

    <section id="Inicio">
        <div class="slide">
            <div class="slide-inner">
                <div class="slide-item" style="background-image: url('../Public/images/1.jpg');"></div>
                <div class="slide-item" style="background-image: url('../Public/images/2.jpg');"></div>
                <div class="slide-item" style="background-image: url('../Public/images/3.jpg');"></div>
            </div>
        </div>
    </section>

    <section id="nosotros">
        <div class="empresa">
            <h1>{{ translator.trans('gym') }}</h1>
            <h2>{{ translator.trans('gymDescripcion') }}</h2>
        </div>
        <br><br>
        <div class="contacto">
            <h1>{{ translator.trans('contactanos') }}</h1>
            <h2>{{ translator.trans('telefono') }}: <span>999 999 999</span>  </h2>
            <h2>{{ translator.trans('email') }}: <span>holahola@gmail.com</span> </h2>
            <h2>{{ translator.trans('oficinas') }}: <span>Agraciada 1243 esq. Millán</span></h2>
        </div>
    </section>

<section id="planes">
        <div class="plan">
            <a href="/planes">{{ translator.trans('3Meses') }}</a>
        </div>
        <div class="plan">
            <a href="/planes">{{ translator.trans('6Meses') }}</a>
        </div>
        <div class="plan">
            <a href="/planes">{{ translator.trans('anual') }}</a>
        </div>
</section>


    {% include 'footer.html.twig' %}

    <script src="../../Public/js/script.js"></script>
    <script src="../../Public/js/responsive.js"></script>
    </div>
</body>
</html>
