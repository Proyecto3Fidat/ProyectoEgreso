<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../../Public/css/registerUsuario.css">
    <link rel="stylesheet" href="../../Public/css/responsive.css">
    <script src="https://kit.fontawesome.com/58f9dcf30d.js" crossorigin="anonymous"></script>
    <title>Registrar Cliente</title>
</head>
<body>
        <div class="registerContainer">

            {% include 'header.html.twig' %}

    <form action= "/registrarcliente" method= "POST" onsubmit="return validateForm()">
        <fieldset>
            <legend>{{ translator.trans('nombre') }}</legend>
            <input type="text" maxlength="30" name="nombre" required>
            <br></br>
            <legend>{{ translator.trans('apellido') }}</legend>
            <input type="text" max="30" name="apellido" required>
            <br></br>
            <legend>{{ translator.trans('telefono') }}</legend>
            <input type="text"  name="telefono"  placeholder="{{ translator.trans('formato') }}" required pattern="\+598\d{8}" title="Debe comenzar con +598 seguido de 8 dígitos">
            <br></br>
            <legend>{{ translator.trans('email') }}</legend>
            <input type="email" maxlength="40"  name="email" required>
            <br></br>
            <legend>{{ translator.trans('contrasena') }}</legend>
            <input type="password"  name="passwd" minlength= "08" required>
        </fieldset>
       
        <fieldset>
            <legend>{{ translator.trans('tipoDocumento') }}</legend>
            <select name="tipoDocumento">
            <option value="CI">{{ translator.trans('cedula') }}</option>
            <option value="Pasaporte">{{ translator.trans('pasaporte') }}</option>
            <br></br>
            <legend>Número de Documento</legend>
            <input type="text" name="nroDocumento" placeholder="{{ translator.trans('documento') }}" required>
            <br></br>
            <h2>{{ translator.trans('nacimiento') }}</h2>
            <input type="date" name="fechaNacimiento" required>
            <br></br>
            <legend>{{ translator.trans('patologias') }}</legend>
            <input type="text" maxlength="25"  name="patologias" required placeholder="{{ translator.trans('patologias') }}">
            <br></br>
            <legend>{{ translator.trans('altura') }}</legend>
            <input type="text" placeholder="1.90" id="altura" name="{{ translator.trans('altura') }}" required>
        </fieldset>
       
        <fieldset>
            <legend>{{ translator.trans('peso') }}</legend>
            <input type="text"  name="peso" required placeholder="{{ translator.trans('peso') }}">
            <br></br>
            <legend>{{ translator.trans('calle') }}</legend>
            <input type="text" maxlength="100"  name="calle" required placeholder="{{ translator.trans('calle') }}">
            <br></br>
            <legend>{{ translator.trans('numero') }}</legend>
            <input type="text"  name="numero" required placeholder="{{ translator.trans('numero') }}">
            <br></br>
            <legend>{{ translator.trans('esquina') }}</legend>
            <input type="text"  name="esquina" required placeholder="{{ translator.trans('esquina') }}">
            <br></br>
        </fieldset> 
        <input type="submit" value="{{ translator.trans('registrarse') }}" class="button">
</form>

           {% include 'footer.html.twig' %}
    <script src="../../Public/js/script.js"></script>
    <script src="../../Public/js/responsive.js"></script>
    </div>
</body>
</html>
