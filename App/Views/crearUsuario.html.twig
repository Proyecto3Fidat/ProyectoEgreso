<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../../Public/css/registerUsuario.css">
    <link rel="stylesheet" href="../../Public/css/responsive.css">
    <script src="https://kit.fontawesome.com/58f9dcf30d.js" crossorigin="anonymous"></script>
    <title>Registrar Cliente</title>
</head>
<body>
            {% include 'header.html.twig' %}
        <div class="registerContainer">


    <form action= "/registrarcliente" method= "POST" onsubmit="return validateForm()">
        <fieldset>
            <input type="text" maxlength="30" name="nombre" required placeholder="{{ translator.trans('nombre') }}" class="input">
            <br></br>
            <input type="text" max="30" name="apellido" required placeholder="{{ translator.trans('apellido') }}" class="input">
            <br></br>   
            <input type="text"  name="telefono"  placeholder="{{ translator.trans('formato') }}" required pattern="\+598\d{8}" class="input">
            <br></br>
            <input type="email" maxlength="40"  name="email" required placeholder="{{ translator.trans('email') }}" class="input">
            <br></br>
            <input type="password"  name="passwd" minlength= "08" required placeholder="{{ translator.trans('passwd') }}" class="input">
        </fieldset>
        
        <fieldset>
            <select name="tipoDocumento" class="input">
            <option value="CI">{{ translator.trans('cedula') }}</option>
            <option value="Pasaporte">{{ translator.trans('pasaporte') }}</option>
            <br></br>
            <input type="text" name="nroDocumento" placeholder="{{ translator.trans('documento') }}" required class="input">
            <br></br>
            <h2>{{ translator.trans('nacimiento') }}</h2>
            <input type="date" name="fechaNacimiento" required class="input">
            <br></br>
            <input type="text" maxlength="25"  name="patologias" required placeholder="{{ translator.trans('patologias') }}" class="input">
            <br></br>
            <input type="text" placeholder="{{ translator.trans('altura') }}" id="altura" name="{{ translator.trans('altura') }}" required class="input">
        </fieldset>
       
        <fieldset>
            <input type="text"  name="peso" required placeholder="{{ translator.trans('peso') }}" class="input">
            <br></br>
            <input type="text" maxlength="100"  name="calle" required placeholder="{{ translator.trans('calle') }}" class="input">
            <br></br>
            <input type="text"  name="numero" required placeholder="{{ translator.trans('numero') }}" class="input">
            <br></br>
            <input type="text"  name="esquina" required placeholder="{{ translator.trans('esquina') }}" class="input">
            <br></br>
        </fieldset> 
        <input type="submit" value="{{ translator.trans('registrarse') }}" class="button">
</form>

    </div>
           {% include 'footer.html.twig' %}
    <script src="../../Public/js/script.js"></script>
    <script src="../../Public/js/responsive.js"></script>
</body>
</html>
