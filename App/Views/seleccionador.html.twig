<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../../Public/css/seleccionador.css">
    <link rel="stylesheet" href="../../Public/css/responsive.css">
    <title>Gestión de Clubes y Deportistas</title>
</head>
<body>
{% include 'header.html.twig' %}

<main>
    <button class="btn-crear" id="btnCrearClub">Crear Club</button>

    <div id="modalCrearClub" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2>Crear Nuevo Club</h2>
            <form id="formCrearClub">
                <label for="nombreClub">Nombre del Club:</label>
                <input type="text" id="nombreClub" name="nombreClub" required>
                <button type="submit">Crear Club</button>
            </form>
        </div>
    </div>

    <div id="modalAsignarClub" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2>Asignar Club</h2>
            <form id="formAsignarClub">
                <label for="selectClub">Seleccione un Club:</label>
                <select id="selectClub" name="clubId" required>
                    {% for club in clubs %}
                        <option value="{{ club.idClub }}">{{ club.nombreClub }}</option>
                    {% endfor %}
                </select>

                <input type="hidden" id="deportistaDocumento" name="deportistaDocumento">
                <input type="hidden" id="deporte" name="deporte">

                <button type="submit">Asignar Club</button>
            </form>
        </div>
    </div>

    <h2 class="section-title">Clubes</h2>
    <table class="tabla" id="tablaClubs">
        <thead>
        <tr>
            <th data-label="Nombre">Nombre</th>
            <th data-label="Id">Id</th>
        </tr>
        </thead>
        <tbody>
        {% for club in clubs %}
            <tr>
                <td data-label="Nombre">{{ club.nombreClub }}</td>
                <td data-label="Id">{{ club.idClub }}</td>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <h2 class="section-title">Deportistas</h2>
    <table class="tabla" id="tablaDeportistas">
        <thead>
        <tr>
            <th data-label="Documento">Documento</th>
            <th data-label="Nombre">Nombre</th>
            <th data-label="Apellido">Apellido</th>
            <th data-label="Edad">Edad</th>
            <th data-label="Deporte">Deporte</th>
            <th data-label="Club">Club</th>
            <th data-label="Acciones">Acciones</th>
        </tr>
        </thead>
        <tbody>
        {% for usuario in usuarios %}
            <tr>
                <td data-label="Documento">{{ usuario.nroDocumento }}</td>
                <td data-label="Nombre">{{ usuario.nombre }}</td>
                <td data-label="Apellido">{{ usuario.apellido }}</td>
                <td data-label="Edad">{{ usuario.edad }}</td>
                <td data-label="Deporte">{{ usuario.deporte }}</td>
                <td data-label="Club">{{ usuario.club }}</td>
                <td data-label="Acciones" class="acciones">
                    <button class="btn-accion" data-documento="{{ usuario.nroDocumento }}" data-deporte="{{ usuario.deporte }}" onclick="mostrarModalAsignarClubDesdeData(this)">Asignar Club</button>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</main>
<script>
    const modalCrearClub = document.getElementById("modalCrearClub");
    const modalAsignarClub = document.getElementById("modalAsignarClub");
    const closeButtons = document.querySelectorAll(".close");

    closeButtons.forEach(button => {
        button.onclick = function() {
            modalCrearClub.style.display = "none";
            modalAsignarClub.style.display = "none";
        };
    });

    document.getElementById("btnCrearClub").onclick = function() {
        modalCrearClub.style.display = "block";
    };

    document.getElementById("formCrearClub").onsubmit = async function(event) {
        event.preventDefault();

        const nombreClub = document.getElementById("nombreClub").value;

        try {
            const response = await fetch('/crear-club', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ nombreClub })
            });

            const data = await response.json();

            if (data.success) {
                alert("Club creado correctamente.");
                modalCrearClub.style.display = "none";
                location.reload();
            } else {
                alert("Error al crear el club: " + data.message);
            }
        } catch (error) {
            console.error("Error:", error);
            alert("Hubo un problema al crear el club.");
        }
    };

    function mostrarModalAsignarClubDesdeData(button) {
        const deportistaDocumento = button.getAttribute("data-documento");
        const deporte = button.getAttribute("data-deporte");

        document.getElementById("deportistaDocumento").value = deportistaDocumento;
        document.getElementById("deporte").value = deporte;

        modalAsignarClub.style.display = "block";
    }

    window.onclick = function(event) {
        if (event.target === modalCrearClub) {
            modalCrearClub.style.display = "none";
        }
        if (event.target === modalAsignarClub) {
            modalAsignarClub.style.display = "none";
        }
    };

    document.getElementById("formAsignarClub").onsubmit = function(event) {
        event.preventDefault();

        const clubId = document.getElementById("selectClub").value;
        const deportistaDocumento = document.getElementById("deportistaDocumento").value;
        const deporte = document.getElementById("deporte").value;

        fetch('/asignar-club', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ clubId, deportistaDocumento, deporte })
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert("Club asignado correctamente.");
                    modalAsignarClub.style.display = "none";
                    location.reload();
                } else {
                    alert("Error al asignar el club: " + data.message);
                }
            })
            .catch(error => {
                console.error("Error:", error);
                alert("Hubo un problema al asignar el club.");
            });
    };
</script>
{% include 'footer.html.twig' %}
</body>
</html>