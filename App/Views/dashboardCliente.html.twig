<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../../public/css/dashEntrenador.css">
    <link rel="stylesheet" href="../../Public/css/responsive.css">
    <script src="https://kit.fontawesome.com/58f9dcf30d.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <title>Dashboard del Usuario</title>
</head>
<body>
<div class="dashboardContainer">
    {% set links = {
        'inicio': '/inicio',
        'horarios': '/horarios',
        'planes': '/planes',
        'nosotros': '/inicio',
    } %}

    {% include 'header.html.twig' with {'links': links} %}



    <section class="informacionUsuario">
        <h2>{{ translator.trans('informacion') }}</h2>
        <div class="usuarioInfo">
            <p><strong>{{ translator.trans('nombre') }}:</strong> {{ usuario.nombre }}</p>
            <p><strong>{{ translator.trans('edad') }}:</strong> {{ usuario.edad }}</p>
            <p><strong>{{ translator.trans('altura') }}:</strong> {{ usuario.altura }}</p>
            <p><strong>{{ translator.trans('peso') }}:</strong> {{ usuario.peso }}</p>
            <p><strong>{{ translator.trans('documento') }}:</strong> {{ usuario.documento }}</p>
        </div>
    </section>
    <section class="rutina">
        <h2>{{ translator.trans('agenda') }}</h2>
        <div class="tablaRutina">
            <table class="clasCliente" id="tablaCalificaciones">
                <thead>
                <tr>
                    <th>{{ translator.trans('dia') }}</th>
                    <th>{{ translator.trans('horaInicio') }}</th>
                    <th>{{ translator.trans('horaFin') }}</th>
                </tr>
                </thead>
                <tbody>
                {% for agendas in agenda %}
                    <tr>
                        <th>{{ agendas.dia }}</th>
                        <td>{{ agendas.horaInicio }}</td>
                        <td>{{ agendas.horaFin }}</td>

                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">{{ translator.trans('noAgenda') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="calificaciones">
        <h2>{{ translator.trans('calificaciones') }}</h2>
        <div class="tablaCliente">
            <table class="clasCliente" id="tablaCalificaciones">
                <thead>
                <tr>
                    <th data-label="Fecha">{{ translator.trans('fecha') }}</th>
                    <th data-label="Puntuación total">{{ translator.trans('puntuacionTotal') }}</th>
                    <th data-label="Fuerza muscular">{{ translator.trans('fuerzaMuscular') }}</th>
                    <th data-label="Resistencia muscular">{{ translator.trans('resistenciaMuscular') }}</th>
                    <th data-label="Resistencia anaerobica">{{ translator.trans('resistenciaAnaerobica') }}</th>
                    <th data-label="Resiliencia">{{ translator.trans('resiliencia') }}</th>
                    <th data-label="Flexibilidad">{{ translator.trans('flexibilidad') }}</th>
                    <th data-label="Cumplimiento de agenda">{{ translator.trans('cumplimientoAgenda') }}</th>
                    <th data-label="Resistencia a la monotonia">{{ translator.trans('resistenciaMonotonia') }}</th>
                    <th class="btnImprimir" data-label=""></th>
                </tr>
                </thead>
                <tbody>
                {% for calificacion in calificaciones %}
                    <tr>
                        <th data-label="Fecha">{{ calificacion.fecha }}</th>
                        <td data-label="Puntuación total">{{ calificacion.puntObtenido }}</td>
                        <td data-label="Fuerza muscular">{{ calificacion.fuerzaMusc }}</td>
                        <td data-label="Resistencia muscular">{{ calificacion.resMusc }}</td>
                        <td data-label="Resistencia anaerobica">{{ calificacion.resAnaerobica }}</td>
                        <td data-label="Resiliencia">{{ calificacion.resiliencia }}</td>
                        <td data-label="Flexibilidad">{{ calificacion.flexibilidad }}</td>
                        <td data-label="Cumplimiento de agenda">{{ calificacion.cumplAgenda }}</td>
                        <td data-label="Resistencia a la monotonia">{{ calificacion.resMonotonia }}</td>
                        <td data-label="">
                            <button class="btnEditar" onclick="window.location.href='imprimirNota?id={{ calificacion.id }}'">Imprimir</button>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="10">{{ translator.trans('noCalificaciones') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="calificacion">
        <h2>{{ translator.trans('rutina') }}</h2>
        <div class="tablaCliente">
            <table class="clasCliente" id="tablaCalificaciones">
                <thead>
                <tr>
                    <th data-label="dia">{{ translator.trans('dia') }}</th>
                    <th data-label="series">{{ translator.trans('series') }}</th>
                    <th data-label="repeticiones">{{ translator.trans('repeticiones') }}</th>
                    <th data-label="comboEjercicios">{{ translator.trans('comboEjercicios') }}</th>
                </tr>
                </thead>
                <tbody>
                {% for rutina in practicas %}
                    <tr>
                        <td data-label="dia">{{ rutina.dia }}</td>
                        <td data-label="series">{{ rutina.series }}</td>
                        <td data-label="repeticiones">{{ rutina.repeticiones }}</td>
                        <td data-label="comboEjercicios">
                            {% for combo in rutina.combo %}
                                {{ combo.nombreCombo }}{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">{{ translator.trans('noRutinas') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="evolucion">
        <div class="graficaEvolucion" id="grafico">
            <p>{{ translator.trans('puedesGrafico') }}</p>
        </div>
    </section>
    <script>
    </script>

    {% include 'footer.html.twig' %}

</div>

<script src="../../Public/js/script.js"></script>
<script src="../../Public/js/responsive.js"></script>

<script>

    const forms = document.querySelectorAll('.asistencia-form');

    forms.forEach(form => {
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            const formData = new FormData(form);

            fetch('/asistencia', {
                method: 'POST',
                body: formData,
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Asistencia enviada correctamente');
                    } else {
                        alert('Hubo un error al enviar la asistencia');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                });
        });
    });
</script>

<script>
    async function crearGrafico(usuarioId) {
        try {
            console.log("Enviando solicitud a /obtenerDatosGrafico con ID:", usuarioId);
            const response = await fetch(`/usuario/obtenerDatosGrafico?documento=${usuarioId}`);
            if (!response.ok) {
                throw new Error(`HTTP error! Status: ${response.status}`);
            }

            const data = await response.json();
            console.log("Datos recibidos:", data);

            // Extrae fechas y valores para cada métrica
            const fechas = data.map(item => item.fecha);
            const series = [
                { name: "{{ translator.trans('puntuacionTotal') }}", data: data.map(item => item.puntObtenido) },
                { name: "{{ translator.trans('fuerzaMuscular') }}", data: data.map(item => item.fuerzaMusc) },
                { name: "{{ translator.trans('resistenciaMuscular') }}", data: data.map(item => item.resMusc) },
                { name: "{{ translator.trans('resistenciaAnaerobica') }}", data: data.map(item => item.resAnaerobica) },
                { name: "{{ translator.trans('resiliencia') }}", data: data.map(item => item.resiliencia) },
                { name: "{{ translator.trans('flexibilidad') }}", data: data.map(item => item.flexibilidad) },
                { name: "{{ translator.trans('cumplimientoAgenda') }}", data: data.map(item => item.cumplAgenda) },
                { name: "{{ translator.trans('resistenciaMuscular') }}", data: data.map(item => item.resMonotonia) },
            ];

            const options = {
                chart: {
                    type: 'line',
                    height: 350,
                    zoom: {
                        enabled: false,
                        type: 'x',
                        autoScaleYaxis: true
                    },
                    toolbar: {
                        show: false,
                        tools: {
                            zoom: true,
                            zoomin: true,
                            zoomout: true,
                            pan: true,
                            reset: true
                        },
                        autoSelected: 'zoom'
                    }
                },
                series: series,
                xaxis: {
                    categories: fechas,
                    title: {
                        text: '{{ translator.trans('fechas') }}'
                    }
                },
                yaxis: {
                    title: {
                        text: '{{ translator.trans('valores') }}'
                    }
                },
                title: {
                    text: '{{ translator.trans('graficoEvolucion') }}',
                    align: 'center'
                },
                legend: {
                    position: 'bottom'
                }
            };

            const chart = new ApexCharts(document.querySelector("#grafico"), options);
            chart.render();
        } catch (error) {
            console.error("Error al crear el gráfico:", error);
        }
    }

    // Llama a la función para cargar el gráfico cuando el DOM esté listo
    document.addEventListener("DOMContentLoaded", function() {
        crearGrafico({{ usuario.documento }});
    });
</script>



</body>
</html>