<link rel="stylesheet" href="../../Public/css/crearEjercicio.css">
<div id="formulario-crear-ejercicio" class="content oculto">
    <form action="/crearEjercicio" method="post" class="califidepo" onsubmit="return validateStrings()">
        <input type="text" id="nombre" name="nombre" placeholder="{{ translator.trans('nombreEjercicio') }}" pattern="[a-zA-Z\s]+" title="Solo se permiten letras y espacios" required>
        <input type="text" id="descripcion" name="descripcion" placeholder="{{ translator.trans('descripcion') }}" pattern="[a-zA-Z\s]+" title="Solo se permiten letras y espacios" required>

        <select id="grupoMuscular" name="grupoMuscular" onchange="toggleFields()" required>
            <option value="" disabled selected>{{ translator.trans('seleccione') }}</option>
            <option value="Pectoral, Hombro y Triceps">{{ translator.trans('pectoralHombroTricep') }}</option>
            <option value="Espalda, Hombro(pres) y Biceps">{{ translator.trans('espaldaHombroBicep') }}</option>
            <option value="Pierna">{{ translator.trans('pierna') }}</option>
            <option value="Entrenamiento de pilates">{{ translator.trans('entrenamientoPilates') }}</option>
        </select><br><br>

        <select id="tipoEjercicio" name="tipoEjercicio" onchange="toggleFields()" required>
            <option value="" disabled selected>{{ translator.trans('tipoDeEjercicio') }}</option>
            <option value="aerobico">{{ translator.trans('aerobico') }}</option>
            <option value="flexibilidad">{{ translator.trans('flexibilidad') }}</option>
            <option value="fuerza o resistencia">{{ translator.trans('fuerzaResistencia') }}</option>
        </select><br><br>

        <input value="{{ translator.trans('enviar') }}" type="submit">
    </form>
</div>

<script>
    function validateStrings() {
        const nombre = document.getElementById('nombre').value.trim();
        const descripcion = document.getElementById('descripcion').value.trim();

        const stringPattern = /^[a-zA-Z\s]+$/;

        if (!stringPattern.test(nombre)) {
            alert("El nombre solo debe contener letras y espacios.");
            return false;
        }

        if (!stringPattern.test(descripcion)) {
            alert("La descripción solo debe contener letras y espacios.");
            return false;
        }

        return true;
    }
</script>
