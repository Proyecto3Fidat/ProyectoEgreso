<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../../Public/css/calificacionIn.css">
    <link rel="stylesheet" href="../../Public/css/responsive.css">
    <script src="https://kit.fontawesome.com/58f9dcf30d.js" crossorigin="anonymous"></script>
    <title>Calificar</title>

</head>
<body>
<div class="content">
    <h4>{{ translator.trans('calificar') }}</h4>
    <form action="/calificacion" method="post" class="califidepo" id="califDepo">
        <input type="text" id="documento" name="nroDocumento" readonly placeholder="{{ translator.trans('documento') }}" required>
        <input name="puntMaxima" type="text" placeholder="{{ translator.trans('puntuacionMaxima') }}">
        <input name="puntuacionEsperado" type="text" placeholder="{{ translator.trans('calificacionEsperada') }}">
        <input name="fuerzaMusc" type="text" placeholder="{{ translator.trans('fuerzaMuscular') }}">
        <input name="resAnaerobica" type="text" placeholder="{{ translator.trans('resistenciaAnaerobica') }}">
        <input name="resiliencia" type="text" placeholder="{{ translator.trans('resiliencia') }}">
        <input name="flexibilidad" type="text" placeholder="{{ translator.trans('flexibilidad') }}">
        <input name="resMusc" type="text" placeholder="{{ translator.trans('resistenciaMuscular') }}">
        <input name="cumplAgenda" type="text" placeholder="{{ translator.trans('cumplimientoAgenda') }}">
        <input name="resMonotonia" type="text" placeholder="{{ translator.trans('resistenciaMonotonia') }}">
        <input type="submit">
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const urlParams = new URLSearchParams(window.location.search);
        const documento = urlParams.get('documento');

        if (documento) {
            document.getElementById('documento').value = documento;
        }
    });
</script>
<script>
    document.querySelector('form.califidepo').addEventListener('submit', function (event) {
        event.preventDefault();

        const formData = new FormData(this);
        fetch('/calificacion', {
            method: 'POST',
            body: formData,
        })
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    alert(data.error);
                } else {
                    alert('Calificación creada con éxito');
                    window.parent.postMessage('cerrarModalCalificacion', '*');
                }
            })
            .catch(error => {
                alert('Hubo un problema con la solicitud. Intenta nuevamente.');
                console.error('Error:', error);
            });
    });
</script>

<script src="../../Public/js/script.js"></script>
<script src="../../Public/js/responsive.js"></script>
</body>
</html>