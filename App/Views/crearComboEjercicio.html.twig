<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear Ejercicio</title>
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #131313;
            color: white;
            margin: 0;
            padding: 20px;
        }
        .crearEjercicio-Container {
            display: flex;
            gap: 20px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .content {
            background-color: #303030;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 30px rgba(0, 0, 0, 1);
            flex: 1;
        }
        .ejercicios-lista {
            background-color: #303030;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 30px rgba(0, 0, 0, 1);
            flex: 1;
            max-height: 600px;
            overflow-y: auto;
        }
        h2 {
            color: #ffffff;
            margin-top: 0;
            font-size: 1.5rem;
        }
        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }
        input[type="text"], select {
            width: 100%;
            padding: 8px;
            margin-bottom: 10px;
            background-color: #222;
            border: 1px solid #6f41bb;
            border-radius: 4px;
            box-sizing: border-box;
            color: white;
        }
        button, input[type="submit"] {
            cursor: pointer;
            font-size: 1rem;
            padding: 0.5rem 1rem;
            color: white;
            border-radius: 3rem;
            border: 2px solid #6f41bb;
            background: linear-gradient(135deg, #303030, #160d1a);
            transition: transform 0.3s ease-out, box-shadow 0.3s ease-out;
        }
        button:hover, input[type="submit"]:hover {
            transform: scale(1.05);
        }
        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .ejercicio-contenedor {
            border: 1px solid #6f41bb;
            padding: 10px;
            margin-bottom: 10px;
            border-radius: 4px;
            background-color: #222;
        }
        .detalle-ejercicio {
            margin-top: 10px;
        }
        ul {
            list-style-type: none;
            padding: 0;
        }
        li {
            margin-bottom: 10px;
            padding: 10px;
            background-color: #222;
            border-radius: 4px;
            border: 1px solid #6f41bb;
        }
        @media screen and (max-width: 768px) {
            .crearEjercicio-Container {
                flex-direction: column;
            }
            button, input[type="submit"] {
                width: 100%;
            }
        }
    </style>
</head>
<body>
<div class="crearEjercicio-Container">
    <div id="formulario-crear-ejercicio" class="content">
        <h2>Crear Combo de Ejercicios</h2>
        <form id="crear-ejercicio-form" action="/crearComboEjercicio" method="post" class="califidepo" onsubmit="return validateStrings()">
            <label for="nombre-combo">{{ translator.trans('nombredelcombo') }}:</label>
            <input type="text" id="nombre-combo" name="nombreCombo" pattern="[a-zA-Z\s]+" title="Solo se permiten letras y espacios" required>
            <div id="ejercicios-seleccionados"></div>
            <button type="button" id="agregar-ejercicio">{{ translator.trans('aniadirEjercicio') }}</button>
            <input type="hidden" name="ejercicios" id="ejercicios-input">
            <input type="submit" value="Enviar">
        </form>
    </div>

    <div id="ejercicios-lista" class="ejercicios-lista">
        <h2>Lista de Ejercicios</h2>
        <ul id="lista-ejercicios"></ul>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const ejerciciosSeleccionados = [];
        const agregarEjercicioBtn = document.getElementById('agregar-ejercicio');

        fetch('/ejercicios')
            .then(response => response.json())
            .then(data => {
                const listaEjercicios = document.getElementById('lista-ejercicios');

                data.forEach(ejercicio => {
                    const listItem = document.createElement('li');
                    listItem.textContent = `Nombre: ${ejercicio.nombre}, Descripción: ${ejercicio.descripcion}, Grupo Muscular: ${ejercicio.grupoMuscular}, Tipo de Ejercicio: ${ejercicio.tipoEjercicio}`;
                    listaEjercicios.appendChild(listItem);
                });

                agregarEjercicioBtn.addEventListener('click', function () {
                    agregarNuevoEjercicio(data);
                });

                agregarNuevoEjercicio(data);
            })
            .catch(error => {
                console.error('Error al obtener los ejercicios:', error);
            });

        function agregarNuevoEjercicio(data) {
            const ejerciciosSeleccionadosDiv = document.getElementById('ejercicios-seleccionados');

            const contenedorEjercicio = document.createElement('div');
            contenedorEjercicio.classList.add('ejercicio-contenedor');

            const nuevoSelect = document.createElement('select');
            nuevoSelect.required = true;
            nuevoSelect.innerHTML = '<option value="" disabled selected>{{ translator.trans('seleccionarEjercicio') }}</option>';

            data.forEach(ejercicio => {
                if (!ejerciciosSeleccionados.some(e => e.idEjercicio === ejercicio.idEjercicio)) {
                    const option = document.createElement('option');
                    option.value = JSON.stringify(ejercicio);
                    option.textContent = ejercicio.nombre;
                    nuevoSelect.appendChild(option);
                }
            });

            const detallesDiv = document.createElement('div');
            detallesDiv.classList.add('detalle-ejercicio');

            const eliminarBtn = document.createElement('button');
            eliminarBtn.type = 'button';
            eliminarBtn.textContent = '{{ translator.trans('eliminarEjercicio') }}';
            eliminarBtn.disabled = true;

            nuevoSelect.addEventListener('change', function () {
                if (this.value) {
                    const ejercicio = JSON.parse(this.value);
                    detallesDiv.innerHTML = `
                    <div>
                        <label>Descripción:</label>
                        <input type="text" value="${ejercicio.descripcion}" readonly>
                        <label>Grupo Muscular:</label>
                        <input type="text" value="${ejercicio.grupoMuscular}" readonly>
                        <label>Tipo de Ejercicio:</label>
                        <input type="text" value="${ejercicio.tipoEjercicio}" readonly>
                    </div>
                `;
                    ejerciciosSeleccionados.push(ejercicio);
                    document.getElementById('ejercicios-input').value = JSON.stringify(ejerciciosSeleccionados);
                    actualizarOpcionesDisponibles();
                    eliminarBtn.disabled = false;
                    agregarEjercicioBtn.disabled = false;
                } else {
                    detallesDiv.innerHTML = '';
                    eliminarBtn.disabled = true;
                }
            });

            eliminarBtn.addEventListener('click', function () {
                if (ejerciciosSeleccionados.length > 1) {
                    ejerciciosSeleccionadosDiv.removeChild(contenedorEjercicio);
                    const index = ejerciciosSeleccionados.findIndex(e => e.idEjercicio === JSON.parse(nuevoSelect.value).idEjercicio);
                    if (index > -1) {
                        ejerciciosSeleccionados.splice(index, 1);
                    }
                    document.getElementById('ejercicios-input').value = JSON.stringify(ejerciciosSeleccionados);
                    actualizarOpcionesDisponibles();
                } else {
                    alert('Debe haber al menos un ejercicio seleccionado.');
                }
            });

            contenedorEjercicio.appendChild(nuevoSelect);
            contenedorEjercicio.appendChild(detallesDiv);
            contenedorEjercicio.appendChild(eliminarBtn);
            ejerciciosSeleccionadosDiv.appendChild(contenedorEjercicio);
        }

        function actualizarOpcionesDisponibles() {
            const selects = document.querySelectorAll('#ejercicios-seleccionados select');
            selects.forEach(select => {
                const opciones = select.querySelectorAll('option');
                opciones.forEach(option => {
                    if (option.value) {
                        const ejercicio = JSON.parse(option.value);
                        option.disabled = ejerciciosSeleccionados.some(e => e.idEjercicio === ejercicio.idEjercicio && e !== JSON.parse(select.value));
                    }
                });
            });
        }
    });

    function validateStrings() {
        const nombreCombo = document.getElementById('nombre-combo').value.trim();
        const stringPattern = /^[a-zA-Z\s]+$/;

        if (!stringPattern.test(nombreCombo)) {
            alert("El nombre del combo solo debe contener letras y espacios.");
            return false;
        }

        return true;
    }
</script>
</body>
</html>