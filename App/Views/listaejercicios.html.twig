<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../../Public/css/listaejercicio.css">
    <link rel="stylesheet" href="../../Public/css/responsive.css">
    <script src="https://kit.fontawesome.com/58f9dcf30d.js" crossorigin="anonymous"></script>
    <title>Lista de Ejercicios</title>
</head>
<body>
    <div class="ejercicios-container">

        {% include 'header.html.twig' %}

        <main>
                <section class="entrenamiento">
                    <table class="listaejercicio">
                        <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Grupo muscular</th>
                            <th>Tipo de ejercicio</th>
                        </tr>
                        </thead>
                        <tbody>
                    {% for ejercicio in ejercicios %}
                        <tr>
                            <td>{{ ejercicio.nombre }}</td>
                            <td>{{ ejercicio.descripcion }}</td>
                            <td>{{ ejercicio.grupoMuscular }}</td>
                            <td>{{ ejercicio.tipoEjercicio }}</td>
                        </tr>
                    {% endfor %}
                        </tbody>
                    </table>
                </section>
        </main>

        {% include 'footer.html.twig' %}
    </div>
    <script src="../../Public/js/script.js"></script>
    <script src="../../Public/js/responsive.js"></script>
</body>
</html>
