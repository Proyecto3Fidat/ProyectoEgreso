<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0 maximum-scale=1.1">
    <link rel="stylesheet" href="../../Public/css/loginusuario.css">
    <link rel="stylesheet" href="../../Public/css/responsive.css">
    <script src="https://kit.fontawesome.com/58f9dcf30d.js" crossorigin="anonymous"></script>
    <title>Ingresar Cliente</title>
</head>
    <body>
<div class="loginContainer">

    {% include 'header.html.twig' %}
    </header>

    <form action="/login" method="post" onsubmit="return errorContraseña()">
        <h2>Usuario</h2>
        <input type="text" required name="documento" placeholder="Documento" > <br> <br>
        <h2>Contraseña</h2>
        <input type="password" required name="passwd" placeholder="Contraseña"> <br> <br>
        <input type="submit" name="Ingresar" value="INGRESAR" class="button">
        <p id="error-message" style="color: red;"></p>
    </form>

    <script src="../../Public/js/script.js"></script>

    <footer class="footer">
        <h1>Gracias por elegirnos!</h1>
        <h2>Nuestras Redes</h2>
        <div class="redes">
            <a href="https://www.instagram.com/fidatdevs/" class="ig-logo">
                <i class="fab fa-instagram"></i>
            </a>
            <a href="https://github.com/Proyecto3Fidat/ProyectoEgreso" class="github-logo">
                <i class="fab fa-github"></i>
            </a>
        </div>
        <h4>Copyright <span>&copy;</span> GYM 2024</h4>
    </footer>
</div>
    </body>
<script src="../../Public/js/responsive.js"></script>
</html>