<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../../Public/css/dashEntrenador.css">
    <link rel="stylesheet" href="../../Public/css/responsive.css">
    <script src="https://kit.fontawesome.com/58f9dcf30d.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <title>Dashboard del Usuario</title>
</head>
<body>
<div class="dashboardContainer">

    {% include 'header.html.twig' %}

    <script src="../../Public/js/listaCalificaciones.js"></script>

    <h1>{{ translator.trans('informacion') }} {{ usuario.nombre }} {{ usuario.apellido }}</h1>

    <!-- Seccion de Informacion del Usuario -->
    <section class="informacionUsuario">
        <h2{{ translator.trans('informacion') }}</h2>
        <div class="usuarioInfo">
            <p><strong>{{ translator.trans('nombre') }}:</strong> {{ usuario.nombre }}</p>
            <p><strong>{{ translator.trans('edad') }}:</strong> {{ usuario.edad }}</p>
            <p><strong>{{ translator.trans('altura') }}:</strong> {{ usuario.altura }}</p>
            <p><strong>{{ translator.trans('peso') }}:</strong> {{ usuario.peso }}</p>
            <p><strong>{{ translator.trans('documento') }}:</strong> {{ usuario.documento }}</p>
        </div>
    </section>

    <section class="calificaciones">
        <h2>{{ translator.trans('calificaciones') }}</h2>
        <button class="btnEditar" onclick="openModalCalificacion()">{{ translator.trans('asignarCalificacion') }}</button>
        <div class="tablaCliente">
            <table class="clasCliente" id="tablaCalificaciones">
                <thead>
                <tr>
                    <th data-label="Fecha">{{ translator.trans('fecha') }}</th>
                    <th data-label="puntuacionTotal">{{ translator.trans('puntuacionTotal') }}</th>
                    <th data-label="fuerzaMuscular">{{ translator.trans('fuerzaMuscular') }}</th>
                    <th data-label="resistenciaMuscular">{{ translator.trans('resistenciaMuscular') }}</th>
                    <th data-label="resistenciaAnaerobica">{{ translator.trans('resistenciaAnaerobica') }}</th>
                    <th data-label="Resilencia">{{ translator.trans('resiliencia') }}</th>
                    <th data-label="Flexibilidad">{{ translator.trans('flexibilidad') }}</th>
                    <th data-label="cumplimientoAgenda">{{ translator.trans('cumplimientoAgenda') }}</th>
                    <th data-label="resistenciaMonotonia">{{ translator.trans('resistenciaMonotonia') }}</th>
                    <th data-label=""></th>
                </tr>
                </thead>
                <tbody>
                {% for calificacion in calificaciones %}
                    <tr>
                        <th data-label="{{ translator.trans('fecha') }}">{{ calificacion.fecha }}</th>
                        <td data-label="{{ translator.trans('puntuacionTotal') }}">{{ calificacion.puntObtenido }}</td>
                        <td data-label="{{ translator.trans('fuerzaMuscular') }}">{{ calificacion.fuerzaMusc }}</td>
                        <td data-label="{{ translator.trans('resistenciaMuscular') }}">{{ calificacion.resMusc }}</td>
                        <td data-label="{{ translator.trans('resistenciaAnaerobica') }}">{{ calificacion.resAnaerobica }}</td>
                        <td data-label="{{ translator.trans('resiliencia') }}">{{ calificacion.resiliencia }}</td>
                        <td data-label="{{ translator.trans('flexibilidad') }}">{{ calificacion.flexibilidad }}</td>
                        <td data-label="{{ translator.trans('cumplimientoAgenda') }}">{{ calificacion.cumplAgenda }}</td>
                        <td data-label="{{ translator.trans('resistenciaMonotonia') }}">{{ calificacion.resMonotonia }}</td>
                        <td>
                            <button class="btnEditar" onclick="abrirModalCalificacion({{ calificacion.id }})">{{ translator.trans('editar') }}</button>
                            <button class="btnEliminar" onclick="eliminarCalificacion({{ calificacion.id }})">{{ translator.trans('eliminar') }}</button>

                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="10">{{ translator.trans('sinCalificacion') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="rutina">
        <h2>{{ translator.trans('rutina') }}</h2>
        <button class="btnAsignarRutina" onclick="openModal()">{{ translator.trans('asignarRutina') }}</button>
        <div class="tablaRutina">
            <table class="clasCliente" id="tablaCalificaciones">
                <thead>
                <tr>
                    <th>{{ translator.trans('dia') }}</th>
                    <th>{{ translator.trans('series') }}</th>
                    <th>{{ translator.trans('repeticiones') }}</th>
                    <th>{{ translator.trans('comboEjercicios') }}</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for rutina in practicas %}
                    <tr>
                        <td data-label="Dia">{{ rutina.dia }}</td>
                        <td data-label="Series">{{ rutina.series }}</td>
                        <td data-label="Repeticiones">{{ rutina.repeticiones }}</td>
                        <td data-label="Combo de Ejercicios">
                            {% for combo in rutina.combo %}
                                {{ combo.nombreCombo }}{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        </td>
                        <td>
                            <button class="btnEditar" onclick="eliminarRutina({{ rutina.idRutina }})">Eliminar</button>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">{{ translator.trans('noRutinas') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="evolucion">
        <div class="graficaEvolucion" id="grafico">
              </div>
    </section>

    <div class="modal" id="modalRutina">
        <div class="modal-content">
            <button class="close-button" onclick="closeModal()">
                <span class="X"></span>
                <span class="Y"></span>
                <div class="close">Close</div>
            </button>
            <iframe id="iframeRutina" src=""></iframe>
        </div>
    </div>

    <!-- Modal para Asignar Calificación -->
    <div class="modal" id="modalAsignarCalificacion">
        <div class="modal-content">
            <button class="close-button" onclick="closeModalAsignarCalificacion()">
                <span class="X"></span>
                <span class="Y"></span>
                <div class="close">Close</div>
            </button>
            <iframe id="iframeAsignarCalificacion" src=""></iframe>
        </div>
    </div>

    <!-- Modal para Editar Calificación -->
    <div class="modal" id="modalCalificacion">
        <div class="modal-content">
            <button class="close-button" onclick="closeModalCalificacion()">
                <span class="X"></span>
                <span class="Y"></span>
                <div class="close">Close</div>
            </button>
            <iframe id="iframeCalificacion" src=""></iframe>
        </div>
    </div>

    <script>
        function openModal() {
            const modal = document.getElementById('modalRutina');
            modal.classList.remove('hide');
            modal.classList.add('show');
            modal.style.display = 'flex';
            document.getElementById('iframeRutina').src = '/asignarRutina?documento={{ usuario.documento }}';
        }

        function closeModal() {
            const modal = document.getElementById('modalRutina');
            modal.classList.remove('show');
            modal.classList.add('hide');
            setTimeout(() => {
                modal.style.display = 'none';
                document.getElementById('iframeRutina').src = '';
                window.location.reload();
            }, 500);
        }

        function openModalCalificacion() {
            const modal = document.getElementById('modalAsignarCalificacion');
            modal.classList.remove('hide');
            modal.classList.add('show');
            modal.style.display = 'flex';
            document.getElementById('iframeAsignarCalificacion').src = '/calificacion?documento={{ usuario.documento }}';
        }

        function closeModalAsignarCalificacion() {
            const modal = document.getElementById('modalAsignarCalificacion');
            modal.classList.remove('show');
            modal.classList.add('hide');
            setTimeout(() => {
                modal.style.display = 'none';
                document.getElementById('iframeAsignarCalificacion').src = '';
                window.location.reload();
            }, 500);
        }

        window.onclick = function(event) {
            const modalRutina = document.getElementById('modalRutina');
            const modalCalificacion = document.getElementById('modalCalificacion');
            const modalAsignarCalificacion = document.getElementById('modalAsignarCalificacion');
            if (event.target === modalRutina) {
                closeModal();
            }
            if (event.target === modalCalificacion) {
                closeModalCalificacion();
            }
            if (event.target === modalAsignarCalificacion) {
                closeModalAsignarCalificacion();
            }
        }

        window.addEventListener('message', function(event) {
            if (event.data === 'cerrarModalRutina') {
                closeModal();
            }
            if (event.data === 'cerrarModalCalificacion') {
                closeModalCalificacion();
            }
            if (event.data === 'cerrarModalAsignarCalificacion') {
                closeModalAsignarCalificacion();
            }
        });

        function abrirModalCalificacion(idCalificacion) {
            const modal = document.getElementById('modalCalificacion');
            modal.classList.remove('hide');
            modal.classList.add('show');
            modal.style.display = 'flex';
            document.getElementById('iframeCalificacion').src = '/editarCalificacion?id=' + idCalificacion;
        }

        function closeModalCalificacion() {
            const modal = document.getElementById('modalCalificacion');
            modal.classList.remove('show');
            modal.classList.add('hide');
            setTimeout(() => {
                modal.style.display = 'none';
                document.getElementById('iframeCalificacion').src = '';
                window.location.reload();
            }, 500);
        }

        function eliminarRutina(idRutina) {
            if (confirm('¿Estás seguro de que deseas eliminar esta rutina al usuario {{ usuario.documento }}?')) {
                fetch('/eliminarRutina', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ idRutina: idRutina })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.status === 'ok') {
                            alert('Rutina eliminada con éxito');
                            window.location.reload();
                        } else {
                            alert('Error al eliminar la rutina. Inténtalo de nuevo.');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Hubo un error al eliminar la rutina. Inténtalo de nuevo.');
                    });
            }
        }

        // Add this function to handle responsive behavior
        function handleResponsive() {
            const width = window.innerWidth;
            const tables = document.querySelectorAll('.clasCliente');

            tables.forEach(table => {
                if (width < 768) {
                    table.classList.add('responsive');
                } else {
                    table.classList.remove('responsive');
                }
            });
        }

        // Call the function on load and resize
        window.addEventListener('load', handleResponsive);
        window.addEventListener('resize', handleResponsive);
    </script>

    {% include 'footer.html.twig' %}

</div>
<script>
    async function crearGrafico(usuarioId) {
        try {
            console.log("Enviando solicitud a /obtenerDatosGrafico con ID:", usuarioId);
            const response = await fetch(`/usuario/obtenerDatosGrafico?documento=${usuarioId}`);
            if (!response.ok) {
                throw new Error(`HTTP error! Status: ${response.status}`);
            }

            const data = await response.json();
            console.log("Datos recibidos:", data);

            // Extrae fechas y valores para cada métrica
            const fechas = data.map(item => item.fecha);
            const series = [
                { name: "{{ translator.trans('puntuacionTotal') }}", data: data.map(item => item.puntObtenido) },
                { name: "{{ translator.trans('fuerzaMuscular') }}", data: data.map(item => item.fuerzaMusc) },
                { name: "{{ translator.trans('resistenciaMuscular') }}", data: data.map(item => item.resMusc) },
                { name: "{{ translator.trans('resistenciaAnaerobica') }}", data: data.map(item => item.resAnaerobica) },
                { name: "{{ translator.trans('resiliencia') }}", data: data.map(item => item.resiliencia) },
                { name: "{{ translator.trans('flexibilidad') }}", data: data.map(item => item.flexibilidad) },
                { name: "{{ translator.trans('cumplimientoAgenda') }}", data: data.map(item => item.cumplAgenda) },
                { name: "{{ translator.trans('resistenciaMuscular') }}", data: data.map(item => item.resMonotonia) },
            ];

            const options = {
                chart: {
                    type: 'line',
                    height: 350,
                    zoom: {
                        enabled: false,
                        type: 'x',
                        autoScaleYaxis: true
                    },
                    toolbar: {
                        show: false,
                        tools: {
                            zoom: true,
                            zoomin: true,
                            zoomout: true,
                            pan: true,
                            reset: true
                        },
                        autoSelected: 'zoom'
                    }
                },
                series: series,
                xaxis: {
                    categories: fechas,
                    title: {
                        text: '{{ translator.trans('fechas') }}'
                    }
                },
                yaxis: {
                    title: {
                        text: '{{ translator.trans('valores') }}'
                    }
                },
                title: {
                    text: '{{ translator.trans('graficoEvolucion') }}',
                    align: 'center'
                },
                legend: {
                    position: 'bottom'
                }
            };

            const chart = new ApexCharts(document.querySelector("#grafico"), options);
            chart.render();
        } catch (error) {
            console.error("Error al crear el gráfico:", error);
        }
    }

    // Llama a la función para cargar el gráfico cuando el DOM esté listo
    document.addEventListener("DOMContentLoaded", function() {
        crearGrafico({{ usuario.documento }});
    });
</script>

<script>
    function eliminarCalificacion(idCalificacion) {
        if (confirm('¿Estás seguro de que deseas eliminar esta calificación?')) {
            fetch('/eliminarCalificacion', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ idCalificacion: idCalificacion })
            })
                .then(response => response.json())
                .then(data => {
                    if (data.status === 'ok') {
                        alert('Calificación eliminada con éxito');
                        window.location.reload();
                    } else {
                        alert('Error al eliminar la calificación. Inténtalo de nuevo.');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Hubo un error al eliminar la calificación. Inténtalo de nuevo.');
                });
        }
    }
</script>
<script src="../../Public/js/script.js"></script>
<script src="../../Public/js/responsive.js"></script>

</body>
</html>